# Faqat development uchun. Nusxa oling: cp .env.example .env
# Production'da .env o'qilmaydi: sozlamalar /etc/admin-bff/admin-bff.env va
# systemd credentials orqali beriladi (deploy/admin-bff.service).

APP_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=admin_bff
DB_USER=admin_bff
DB_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
