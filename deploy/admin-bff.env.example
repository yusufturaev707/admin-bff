# /etc/admin-bff/admin-bff.env (root:root 0640) - secret BO'LMAGAN sozlamalar.
# Parollar va kalitlar bu yerga yozilmaydi: ular /etc/admin-bff/credentials/
# ichida turadi va systemd LoadCredential= orqali beriladi.

LOG_LEVEL=INFO
LOG_FORMAT=json

# TODO(owner): aniq domen nomi (10-bo'lim).
FRONTEND_ORIGIN=https://admin.uzbmb.uz

# PostgreSQL unix socket orqali (peer/scram-sha-256).
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME=admin_bff
# Servis shu rol bilan ishlaydi: audit jadvallarida faqat SELECT va INSERT.
DB_USER=admin_bff
# Sxema egasi: faqat migratsiyalar (deploy.sh). Paroli credentials/db_owner_password,
# u servisga berilmaydi.
DB_OWNER_USER=admin_bff_owner

# Audit log saqlash muddati, kun (9-bo'lim). Kamida 90.
AUDIT_RETENTION_DAYS=90

# Sessiya Redis'i (requirepass). Voqealar Redis'i alohida instans (8-bosqich).
REDIS_URL=unix:///run/redis/redis-server.sock?db=0

GUNICORN_WORKERS=4

# Auth (6-bo'lim). Kalitlar credentials orqali (admin-bff.service).
TOTP_ISSUER=UZBMB Admin
# Egasining qarori (2026-11-23): TOTP hozircha o'chiq, kirish faqat parol bilan.
# Yoqish uchun true qiling va servisni qayta ishga tushiring (docs/security.md).
TOTP_REQUIRED=false
SESSION_IDLE_TIMEOUT_S=1800
SESSION_ABSOLUTE_TIMEOUT_S=43200

# OneID: shablon, hali ulanmagan (app/auth/oneid.py, TODO(owner)).
ONEID_ENABLED=false
# ONEID_CLIENT_ID=
# ONEID_REDIRECT_URI=https://admin-api.uzbmb.uz/api/v1/auth/oneid/callback
