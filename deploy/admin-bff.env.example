# /etc/admin-bff/admin-bff.env (root:root 0640) - secret BO'LMAGAN sozlamalar.
# Parollar va kalitlar bu yerga yozilmaydi: ular /etc/admin-bff/credentials/
# ichida turadi va systemd LoadCredential= orqali beriladi.

LOG_LEVEL=INFO
LOG_FORMAT=json

# TODO(owner): aniq domen nomi (10-bo'lim).
FRONTEND_ORIGIN=https://admin.uzbmb.uz

# PostgreSQL unix socket orqali (peer/scram-sha-256).
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME=admin_bff
DB_USER=admin_bff

# Sessiya Redis'i (requirepass). Voqealar Redis'i alohida instans (8-bosqich).
REDIS_URL=unix:///run/redis/redis-server.sock?db=0

GUNICORN_WORKERS=4
