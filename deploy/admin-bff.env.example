# /etc/admin-bff/admin-bff.env (root:root 0640) - secret BO'LMAGAN sozlamalar.
# Parollar va kalitlar bu yerga yozilmaydi: ular /etc/admin-bff/credentials/
# ichida turadi va systemd LoadCredential= orqali beriladi.

LOG_LEVEL=INFO
LOG_FORMAT=json

# TODO(owner): aniq domen nomi (10-bo'lim).
FRONTEND_ORIGIN=https://admin.uzbmb.uz

# PostgreSQL boshqa serverda (docs/deploy.md, 5-qadam). Shu to'rtta qiymat va
# parol kerak, parol credentials/db_password faylida turadi. DB serverida TLS
# yoqilgan bo'lsa, ulanish o'zi shifrlanadi.
# TODO(owner): DB serverining IP manzili, porti, baza nomi va user.
DB_HOST=10.0.0.10
DB_PORT=5432
DB_NAME=admin_bff
DB_USER=admin_bff

# Audit log saqlash muddati, kun (9-bo'lim). Kamida 90.
AUDIT_RETENTION_DAYS=90

# Sessiya Redis'i: alohida instans (deploy/admin-bff-redis.service), requirepass.
# Voqealar Redis'i ham alohida bo'ladi (8-bosqich).
REDIS_URL=unix:///run/admin-bff-redis/redis.sock?db=0

# Worker'lar soni va Argon2 parallelligi MemoryMax=1G'ga sig'ishi kerak
# (hisob: deploy/gunicorn.conf.py). Oshirilsa, MemoryMax ham oshiriladi.
GUNICORN_WORKERS=4
# ARGON2_MAX_CONCURRENCY=1

# Auth (6-bo'lim). Kalitlar credentials orqali (admin-bff.service).
SESSION_IDLE_TIMEOUT_S=1800
SESSION_ABSOLUTE_TIMEOUT_S=43200

# Vaqtinchalik, domen olinguncha (deploy/nginx/admin-bff-test.conf):
# frontendchi Swagger UI'dan login qiladi va so'rov yuboradi. Frontend ishga
# tushgach o'chiriladi (docs/deploy.md).
# DOCS_TRY_IT_OUT=true

# OneID: shablon, hali ulanmagan (app/auth/oneid.py, TODO(owner)).
ONEID_ENABLED=false
# ONEID_CLIENT_ID=
# ONEID_REDIRECT_URI=https://admin-api.uzbmb.uz/api/v1/auth/oneid/callback
