# /etc/systemd/system/admin-bff-audit-retention.timer
# Har kuni tunda: admin-bff-audit-retention.service (9-bo'lim).
# Holat: systemctl list-timers admin-bff-audit-retention.timer

[Unit]
Description=Daily audit retention of the UZBMB Admin BFF

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
# Server o'chiq bo'lgan kun o'tkazib yuborilmaydi: yoqilganda ishga tushadi.
Persistent=true

[Install]
WantedBy=timers.target
