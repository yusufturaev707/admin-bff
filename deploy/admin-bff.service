# /etc/systemd/system/admin-bff.service
#
# O'rnatish (bir marta):
#   useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin admin-bff
#   usermod -aG admin-bff www-data          # Nginx socket'ga guruh orqali kiradi
#   # PostgreSQL: ikki rol (README, "PostgreSQL rollari"). admin_bff_owner sxemani
#   # yaratadi (migratsiyalar), admin_bff servisning o'zi: u audit log'ni
#   # o'zgartira olmaydi. Aks holda servis production'da ishga tushmaydi.
#   install -d -o root -g root -m 0700 /etc/admin-bff/credentials
#   # har bir secret alohida faylda, root:root 0600:
#   #   /etc/admin-bff/credentials/db_password        (admin_bff roli)
#   #   /etc/admin-bff/credentials/db_owner_password  (admin_bff_owner; faqat deploy.sh)
#   #   /etc/admin-bff/credentials/redis_password
#   #   /etc/admin-bff/credentials/totp_enc_key     (32 bayt, base64)
#   #   /etc/admin-bff/credentials/pinfl_hmac_key   (32+ bayt, base64)
#   # kalit yaratish (faylga yoziladi, ekranga chiqmaydi):
#   #   (umask 077; head -c 32 /dev/urandom | base64 > /etc/admin-bff/credentials/totp_enc_key)
#   #   (umask 077; head -c 32 /dev/urandom | base64 > /etc/admin-bff/credentials/pinfl_hmac_key)
#   # Kalitlarning zaxira nusxasi, rotatsiyasi va yo'qolganda nima qilish:
#   # docs/security.md ("Kalitlar").
#   cp deploy/admin-bff.env.example /etc/admin-bff/admin-bff.env   # root:root 0640
#   cp deploy/admin-bff-audit-retention.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now admin-bff
#   systemctl enable --now admin-bff-audit-retention.timer       # 9-bo'lim, har kuni
#
# Tekshirish: systemd-analyze security admin-bff

[Unit]
Description=UZBMB Admin BFF
Documentation=file:///opt/admin-bff/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=admin-bff
Group=admin-bff
WorkingDirectory=/opt/admin-bff

# Oddiy (secret bo'lmagan) sozlamalar.
EnvironmentFile=/etc/admin-bff/admin-bff.env
Environment=APP_ENV=production PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Secret'lar: ilova ularni $CREDENTIALS_DIRECTORY'dan o'qiydi (pydantic-settings
# secrets_dir). Fayl nomi = sozlama nomi. db_owner_password bu yerda yo'q va
# bo'lmasligi kerak: servis audit jadvallarini o'zgartira olmasin (9-bo'lim).
# Keyingi bosqichlarda qo'shiladi:
#   LoadCredential=jwt_private_key:/etc/admin-bff/credentials/jwt_private_key (4-bosqich)
#   LoadCredential=oneid_client_secret:/etc/admin-bff/credentials/oneid_client_secret
#     (OneID integratsiyasi, TODO(owner))
LoadCredential=db_password:/etc/admin-bff/credentials/db_password
LoadCredential=redis_password:/etc/admin-bff/credentials/redis_password
LoadCredential=totp_enc_key:/etc/admin-bff/credentials/totp_enc_key
LoadCredential=pinfl_hmac_key:/etc/admin-bff/credentials/pinfl_hmac_key
# Faqat TOTP_ENC_KEY rotatsiyasi paytida ochiladi (docs/security.md):
#LoadCredential=totp_enc_key_previous:/etc/admin-bff/credentials/totp_enc_key_previous

ExecStart=/opt/admin-bff/.venv/bin/gunicorn --config /opt/admin-bff/deploy/gunicorn.conf.py "app.main:create_app()"
# HUP: Gunicorn worker'larni yangi kod bilan navbatma-navbat qayta ishga tushiradi.
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=35
Restart=on-failure
RestartSec=5

# /run/admin-bff: socket va gunicorn heartbeat fayllari (tmpfs).
RuntimeDirectory=admin-bff
RuntimeDirectoryMode=0750

# --- Hardening ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Staging'da tekshirilsin: biror kutubxona JIT/W+X xotira talab qilsa, o'chiriladi.
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Gunicorn socket va heartbeat fayllarini o'z uid/gid'iga chown qiladi
# (gunicorn/sock.py, workers/workertmp.py). CAP_CHOWN yo'q, shuning uchun bu
# boshqa egaga o'tkazishga imkon bermaydi.
SystemCallFilter=@chown
# Bloklangan syscall jarayonni SIGSYS bilan o'ldirmasin, EPERM qaytarsin
# (xato log'da ko'rinadi).
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Hozir barcha tizimlar shu serverda (8-bo'lim): BFF faqat localhost bilan
# gaplashadi. Tizimlar boshqa serverlarga ko'chsa, ularning IP'lari qo'shiladi.
# TODO(owner): OneID yoqilganda uning token/userinfo serverlari IP'lari
# IPAddressAllow'ga qo'shiladi (BFF code'ni server tomonda almashtiradi).
IPAddressDeny=any
IPAddressAllow=localhost
# BFF diskka hech narsa yozmaydi (loglar journald'da), shuning uchun
# ReadWritePaths kerak emas.
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
