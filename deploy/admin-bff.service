# /etc/systemd/system/admin-bff.service
#
# O'rnatish (bir marta):
#   useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin admin-bff
#   usermod -aG admin-bff www-data          # Nginx socket'ga guruh orqali kiradi
#   install -d -o root -g root -m 0700 /etc/admin-bff/credentials
#   # har bir secret alohida faylda, root:root 0600:
#   #   /etc/admin-bff/credentials/db_password
#   #   /etc/admin-bff/credentials/redis_password
#   cp deploy/admin-bff.env.example /etc/admin-bff/admin-bff.env   # root:root 0640
#   systemctl daemon-reload && systemctl enable --now admin-bff
#
# Tekshirish: systemd-analyze security admin-bff

[Unit]
Description=UZBMB Admin BFF
Documentation=file:///opt/admin-bff/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=admin-bff
Group=admin-bff
WorkingDirectory=/opt/admin-bff

# Oddiy (secret bo'lmagan) sozlamalar.
EnvironmentFile=/etc/admin-bff/admin-bff.env
Environment=APP_ENV=production PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Secret'lar: ilova ularni $CREDENTIALS_DIRECTORY'dan o'qiydi (pydantic-settings
# secrets_dir). Fayl nomi = sozlama nomi. Keyingi bosqichlarda qo'shiladi:
#   LoadCredential=totp_enc_key:/etc/admin-bff/credentials/totp_enc_key      (1-bosqich)
#   LoadCredential=jwt_private_key:/etc/admin-bff/credentials/jwt_private_key (4-bosqich)
LoadCredential=db_password:/etc/admin-bff/credentials/db_password
LoadCredential=redis_password:/etc/admin-bff/credentials/redis_password

ExecStart=/opt/admin-bff/.venv/bin/gunicorn --config /opt/admin-bff/deploy/gunicorn.conf.py "app.main:create_app()"
# HUP: Gunicorn worker'larni yangi kod bilan navbatma-navbat qayta ishga tushiradi.
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=35
Restart=on-failure
RestartSec=5

# /run/admin-bff: socket va gunicorn heartbeat fayllari (tmpfs).
RuntimeDirectory=admin-bff
RuntimeDirectoryMode=0750

# --- Hardening ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Staging'da tekshirilsin: biror kutubxona JIT/W+X xotira talab qilsa, o'chiriladi.
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Gunicorn socket va heartbeat fayllarini o'z uid/gid'iga chown qiladi
# (gunicorn/sock.py, workers/workertmp.py). CAP_CHOWN yo'q, shuning uchun bu
# boshqa egaga o'tkazishga imkon bermaydi.
SystemCallFilter=@chown
# Bloklangan syscall jarayonni SIGSYS bilan o'ldirmasin, EPERM qaytarsin
# (xato log'da ko'rinadi).
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Hozir barcha tizimlar shu serverda (8-bo'lim): BFF faqat localhost bilan
# gaplashadi. Tizimlar boshqa serverlarga ko'chsa, ularning IP'lari qo'shiladi.
IPAddressDeny=any
IPAddressAllow=localhost
# BFF diskka hech narsa yozmaydi (loglar journald'da), shuning uchun
# ReadWritePaths kerak emas.
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
