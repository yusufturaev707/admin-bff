    "/api/v1/auth/oneid/start": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "OneID orqali kirish (brauzer shu manzilga o'tadi)",
        "operationId": "auth_oneid_start",
        "responses": {
          "302": {
            "description": "OneID sahifasiga yo'naltirish"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oneid/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "OneID qaytish manzili (frontendga yo'naltiradi)",
        "operationId": "auth_oneid_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Frontend sahifasiga yo'naltirish"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthMethod": {
        "type": "string",
        "enum": [
          "password",
          "oneid"
        ],
        "title": "AuthMethod"
      },
      "CodeRequest": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "description": "Autentifikator ilovasidagi 6 xonali kod"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CodeRequest"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "example": {
          "code": "forbidden",
          "details": {},
          "message": "Bu amal uchun ruxsat yo'q",
          "request_id": "0b9c5e1e-3f7a-4d43-9a43-6f1a2b9d8c11"
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "not_authenticated",
          "session_expired",
          "forbidden",
          "step_up_required",
          "csrf_failed",
          "not_found",
          "method_not_allowed",
          "validation_error",
          "conflict",
          "rate_limited",
          "system_unavailable",
          "upstream_error",
          "internal_error"
        ],
        "title": "ErrorCode"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "example": {
          "status": "ok"
        }
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "example": {
          "password": "...",
          "username": "operator_toshkent"
        }
      },
      "LoginResponse": {
        "properties": {
          "mfa_required": {
            "type": "boolean",
            "title": "Mfa Required"
          },
          "mfa_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mfa Token",
            "description": "Bir martalik, 5 daqiqa amal qiladi"
          },
          "setup_required": {
            "type": "boolean",
            "title": "Setup Required",
            "default": false
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/PendingStep"
            },
            "type": "array",
            "title": "Pending"
          },
          "csrf_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "mfa_required"
        ],
        "title": "LoginResponse",
        "description": "Either `mfa_required` (continue with /auth/mfa) or, on the very first\nsign-in, a setup session (`setup_required`, cookie set, `csrf_token`).",
        "examples": [
          {
            "mfa_required": true,
            "mfa_token": "...",
            "setup_required": false
          },
          {
            "csrf_token": "...",
            "mfa_required": false,
            "pending": [
              "totp_enrollment",
              "password_change"
            ],
            "setup_required": true
          }
        ]
      },
      "MfaRequest": {
        "properties": {
          "mfa_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Mfa Token"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "recovery_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24,
                "minLength": 16
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mfa_token"
        ],
        "title": "MfaRequest",
        "example": {
          "code": "123456",
          "mfa_token": "..."
        }
      },
      "PasswordChangeRequest": {
        "properties": {
          "old_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Old Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "New Password"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "description": "Autentifikator ilovasidagi 6 xonali kod"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "old_password",
          "new_password",
          "code"
        ],
        "title": "PasswordChangeRequest"
      },
      "PendingStep": {
        "type": "string",
        "enum": [
          "totp_enrollment",
          "password_change"
        ],
        "title": "PendingStep",
        "description": "Setup steps that must be finished before the session gets full access."
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "error"
              ]
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "example": {
          "checks": {
            "db": "ok",
            "redis": "ok"
          },
